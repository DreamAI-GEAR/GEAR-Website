---
interface Props {
  nav: { label: string; href: string }[];
  currentPath: string;
}

const { nav, currentPath } = Astro.props;
const base = import.meta.env.BASE_URL;

function resolveHref(href: string): string {
  if (href.startsWith('http')) return href;
  return `${base}${href.replace(/^\//, '')}`;
}

function isActive(href: string): boolean {
  const full = resolveHref(href);
  if (full === base || full === `${base}`) {
    return currentPath === base || currentPath === base.replace(/\/$/, '') || currentPath === `${base}`;
  }
  return currentPath.startsWith(full);
}
---

<header class="sticky top-0 z-50 w-full border-b border-gray-100 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href={base} class="text-xl font-bold tracking-tight text-violet-600">GEAR</a>

    {/* Desktop nav */}
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main navigation">
      {nav.map((item) => {
        const href = resolveHref(item.href);
        const active = isActive(item.href);
        return (
          <a
            href={href}
            class:list={[
              'text-sm font-medium transition-colors duration-200',
              active ? 'text-violet-600' : 'text-gray-600 hover:text-violet-600',
            ]}
            aria-current={active ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    {/* Mobile hamburger button */}
    <button
      type="button"
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-lg p-2 text-gray-600 hover:bg-gray-100 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  {/* Mobile menu */}
  <nav
    id="mobile-menu"
    class="hidden border-t border-gray-100 bg-white px-4 pb-4 pt-2 md:hidden"
    aria-label="Mobile navigation"
  >
    {nav.map((item) => {
      const href = resolveHref(item.href);
      const active = isActive(item.href);
      return (
        <a
          href={href}
          class:list={[
            'block rounded-lg px-3 py-2 text-sm font-medium transition-colors duration-200',
            active ? 'bg-violet-50 text-violet-600' : 'text-gray-600 hover:bg-gray-50 hover:text-violet-600',
          ]}
          aria-current={active ? 'page' : undefined}
        >
          {item.label}
        </a>
      );
    })}
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
