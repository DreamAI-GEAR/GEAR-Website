---
import TagBadge from './TagBadge.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
  tags?: string[];
}

const { title, description, href, tags } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  {...(href ? { href } : {})}
  class:list={[
    'group block rounded-2xl border border-gray-100 bg-white p-5 shadow-sm',
    'transition-all duration-200 ease-out',
    href && 'hover:-translate-y-0.5 hover:shadow-md hover:border-l-violet-600 hover:border-l-2',
  ]}
>
  <h3 class="text-balance text-lg font-semibold text-gray-900">{title}</h3>
  {description && (
    <p class="mt-2 text-pretty text-sm leading-relaxed text-gray-600">{description}</p>
  )}
  {tags && tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((tag) => <TagBadge tag={tag} />)}
    </div>
  )}
</Tag>
