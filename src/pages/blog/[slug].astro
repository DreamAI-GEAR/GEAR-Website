---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagBadge from '../../components/TagBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  return allPosts
    .filter((p) => p.data.state === 'published')
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

type Post = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${post.data.title} - GEAR Blog`}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href={`${base}blog`} class="text-sm text-gray-400 hover:text-violet-600">&larr; 블로그 목록</a>

    <h1 class="mt-4 text-balance text-4xl font-bold text-gray-900">{post.data.title}</h1>

    <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-gray-500">
      <span>{post.data.authors.join(', ')}</span>
      <span>&middot;</span>
      <time datetime={post.data.publishedDate.toISOString()}>
        {post.data.publishedDate.toLocaleDateString('ko-KR')}
      </time>
    </div>

    {post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => <TagBadge tag={tag} />)}
      </div>
    )}

    <div class="blog-prose mt-8">
      <Content />
    </div>
  </article>
</BaseLayout>
