---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.data.state === 'published')
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Blog - GEAR">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-balance text-3xl font-bold text-gray-900">블로그</h1>
    <p class="mt-2 text-pretty text-gray-600">GEAR 팀의 기술 블로그입니다.</p>

    {posts.length === 0 && (
      <p class="mt-8 text-gray-500">아직 게시된 글이 없습니다.</p>
    )}

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <Card
          title={post.data.title}
          description={`${post.data.authors.join(', ')} · ${post.data.publishedDate.toLocaleDateString('ko-KR')}`}
          href={`${base}blog/${post.id}`}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>
</BaseLayout>
