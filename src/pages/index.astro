---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import TypeWriter from '../components/TypeWriter.astro';
import TagBadge from '../components/TagBadge.astro';
import { getCollection, render } from 'astro:content';

const homeEntries = await getCollection('home');
const homeData = homeEntries[0];
const { teamName, teamFullName, org, tagline, vision, goals, recentActivities, contact } = homeData.data;

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => p.data.state === 'published')
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 3);

const allEvents = await getCollection('events');
const latestEvent = allEvents.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`${teamName} - ${org}`}>
  {/* Hero */}
  <section class="bg-gradient-to-br from-violet-600 to-violet-800 px-4 py-20 text-center text-white sm:py-28">
    <div class="mx-auto max-w-3xl">
      <h1 class="text-balance text-4xl font-bold tracking-tight sm:text-5xl">{teamName}</h1>
      <p class="mt-2 text-lg text-violet-200">{teamFullName}</p>
      <p class="mt-6 text-xl text-violet-100">
        <TypeWriter text={tagline} />
      </p>
    </div>
  </section>

  {/* Vision & Goals */}
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h2 class="text-balance text-2xl font-bold text-gray-900">비전</h2>
    <p class="mt-3 text-pretty leading-relaxed text-gray-600">{vision}</p>

    <h2 class="mt-12 text-balance text-2xl font-bold text-gray-900">목표</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2">
      {goals.map((goal) => (
        <li class="flex items-start gap-2 rounded-2xl border border-gray-100 bg-white p-4 shadow-sm">
          <span class="mt-0.5 text-violet-500">&#10003;</span>
          <span class="text-pretty text-gray-700">{goal}</span>
        </li>
      ))}
    </ul>
  </section>

  {/* Recent Blog Posts */}
  {publishedPosts.length > 0 && (
    <section class="border-t border-gray-100 bg-gray-50">
      <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
        <h2 class="text-balance text-2xl font-bold text-gray-900">최근 블로그</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {publishedPosts.map((post) => (
            <Card
              title={post.data.title}
              description={`${post.data.authors.join(', ')} · ${post.data.publishedDate.toLocaleDateString('ko-KR')}`}
              href={`${base}blog/${post.id}`}
              tags={post.data.tags}
            />
          ))}
        </div>
        <div class="mt-6 text-center">
          <a href={`${base}blog`} class="text-sm font-medium text-violet-600 hover:text-violet-700">
            모든 글 보기 &rarr;
          </a>
        </div>
      </div>
    </section>
  )}

  {/* Latest Event */}
  {latestEvent && (
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="text-balance text-2xl font-bold text-gray-900">최근 활동</h2>
      <div class="mt-6">
        <Card
          title={latestEvent.data.title}
          description={`${latestEvent.data.category} · ${latestEvent.data.date.toLocaleDateString('ko-KR')} · ${latestEvent.data.attendees.length}명 참석`}
          href={`${base}events`}
        />
      </div>
    </section>
  )}

  {/* Contact */}
  <section class="border-t border-gray-100 bg-gray-50">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <h2 class="text-balance text-2xl font-bold text-gray-900">연락처</h2>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-6 text-gray-600">
        {contact.email && (
          <a href={`mailto:${contact.email}`} class="text-violet-600 hover:text-violet-700 transition-colors">
            {contact.email}
          </a>
        )}
        {contact.github && (
          <a href={contact.github} target="_blank" rel="noopener noreferrer" class="text-violet-600 hover:text-violet-700 transition-colors">
            GitHub
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
