---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoleBadge from '../../components/RoleBadge.astro';
import { getCollection, render } from 'astro:content';

const allMembers = await getCollection('members');

const roleOrder: Record<string, number> = { '교수': 0, '멘토': 1, '리드': 2, '멤버': 3 };
const members = allMembers.sort(
  (a, b) => (roleOrder[a.data.role] ?? 9) - (roleOrder[b.data.role] ?? 9)
);

const rendered = await Promise.all(
  members.map(async (m) => {
    const { Content } = await render(m);
    return { entry: m, Content };
  })
);
---

<BaseLayout title="Members - GEAR">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-balance text-3xl font-bold text-gray-900">멤버</h1>
    <p class="mt-2 text-pretty text-gray-600">GEAR 팀을 구성하는 멤버들입니다.</p>

    {/* Tabs */}
    <div class="mt-8 flex flex-wrap gap-0 border-b border-gray-200">
      {members.map((m, i) => (
        <button
          type="button"
          data-tab={m.id}
          class:list={[
            'shrink-0 border-b-2 px-4 py-2 text-sm font-medium transition-colors',
            i === 0
              ? 'border-violet-600 text-violet-600'
              : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700',
          ]}
        >
          {m.data.name}
        </button>
      ))}
    </div>

    {/* Panels */}
    {rendered.map(({ entry, Content }, i) => (
      <div
        data-panel={entry.id}
        class:list={['mt-6', i !== 0 && 'hidden']}
      >
        <div class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <h2 class="text-xl font-semibold text-gray-900">{entry.data.name}</h2>
            <RoleBadge role={entry.data.role} />
          </div>
          <p class="mt-2 text-pretty text-gray-600">{entry.data.bio}</p>
          {entry.data.links && entry.data.links.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-3">
              {entry.data.links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-sm text-violet-600 hover:text-violet-700">
                  {link.label} &rarr;
                </a>
              ))}
            </div>
          )}
          <div class="blog-prose mt-6">
            <Content />
          </div>
        </div>
      </div>
    ))}
  </section>

  <script>
    document.querySelectorAll('[data-tab]').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('[data-panel]').forEach(p => p.classList.add('hidden'));
        document.querySelectorAll('[data-tab]').forEach(t => {
          t.classList.remove('border-violet-600', 'text-violet-600');
          t.classList.add('border-transparent', 'text-gray-500');
        });
        const target = (tab as HTMLElement).dataset.tab;
        document.querySelector(`[data-panel="${target}"]`)?.classList.remove('hidden');
        tab.classList.remove('border-transparent', 'text-gray-500');
        tab.classList.add('border-violet-600', 'text-violet-600');
      });
    });
  </script>
</BaseLayout>
