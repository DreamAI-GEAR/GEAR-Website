---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const allDocs = await getCollection('docs');
const readmes = allDocs.filter((doc) => doc.id.toLowerCase().endsWith('readme'));

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Projects - GEAR">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-balance text-3xl font-bold text-gray-900">프로젝트</h1>
    <p class="mt-2 text-pretty text-gray-600">GEAR 팀이 진행 중인 프로젝트들입니다.</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {readmes.map((doc) => {
        const project = doc.id.split('/')[0];
        return (
          <Card
            title={doc.data.title}
            description={doc.data.description}
            href={`${base}projects/${project}/docs`}
            tags={doc.data.status ? [doc.data.status] : []}
          />
        );
      })}
    </div>
  </section>
</BaseLayout>
