---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 - GEAR">
  <section class="flex flex-1 flex-col items-center justify-center px-4 py-24 text-center">
    <h1 class="text-6xl font-bold text-violet-600">404</h1>
    <p class="mt-4 text-lg text-gray-600">페이지를 찾을 수 없습니다.</p>
    <a
      href={base}
      class="mt-6 inline-block rounded-lg bg-violet-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-violet-700"
    >
      홈으로 돌아가기
    </a>
  </section>
</BaseLayout>
