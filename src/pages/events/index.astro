---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const rendered = await Promise.all(
  events.map(async (e) => {
    const { Content } = await render(e);
    return { entry: e, Content };
  })
);
---

<BaseLayout title="Events - GEAR">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <h1 class="text-balance text-3xl font-bold text-gray-900">이벤트</h1>
    <p class="mt-2 text-pretty text-gray-600">GEAR 팀의 활동 기록입니다.</p>

    {events.length === 0 && (
      <p class="mt-8 text-gray-500">아직 등록된 이벤트가 없습니다.</p>
    )}

    <div class="mt-8 space-y-4">
      {rendered.map(({ entry, Content }) => (
        <article class="rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
          <div class="flex flex-wrap items-center gap-3">
            <span class="inline-block rounded-full bg-violet-100 px-2.5 py-0.5 text-xs font-medium text-violet-700">
              {entry.data.category}
            </span>
            <time class="text-sm text-gray-400" datetime={entry.data.date.toISOString()}>
              {entry.data.date.toLocaleDateString('ko-KR')}
            </time>
            <span class="text-sm text-gray-400">{entry.data.attendees.length}명 참석</span>
          </div>
          <h2 class="mt-2 text-balance text-xl font-semibold text-gray-900">{entry.data.title}</h2>
          <div class="blog-prose mt-4">
            <Content />
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
