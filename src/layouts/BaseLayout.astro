---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'GEAR - DreamAI Research Team' } = Astro.props;

const homeEntries = await getCollection('home');
const home = homeEntries[0]?.data;
const nav = home?.nav ?? [];
const contact = home?.contact ?? { email: '', github: '' };
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh flex flex-col font-sans text-gray-900 bg-white antialiased">
    <Header nav={nav} currentPath={Astro.url.pathname} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer contact={contact} />
  </body>
</html>
